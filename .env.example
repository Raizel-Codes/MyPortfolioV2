# Copy to .env.local and fill in. Never commit .env.local.

# Where the "Email me" button opens a Gmail draft to (kept server-side, not in the page HTML)
CONTACT_EMAIL=

# Your Facebook page/profile URL for the Facebook button
FACEBOOK_URL=

# Optional: shared storage for rate limits + like/view counts (https://upstash.com, free tier).
# Without these, counts and limits live in server memory and reset on restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
